APP_ENV=local
APP_NAME=mworks-api
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mworks
DB_USER=mworks
DB_PASSWORD=mworks_local_change_me
DB_SSLMODE=

JWT_ISS=mworks
JWT_AUD=mworks-web
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
# Optional PEM text for serverless hosts (Vercel). Local Docker still uses the files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=mworks
S3_ACCESS_KEY=mworks
S3_SECRET_KEY=mworks_minio_change_me
S3_REGION=us-east-1

APP_PUBLIC_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

DEMO_USER_EMAIL=henry@mworks.ng
DEMO_USER_PASSWORD=ChangeMe1a!

# DeepSeek Anthropic-compatible endpoint. Leave empty to keep the rule-based assistant.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
# Upload gates. Never put a model on this path. SCAN_REQUIRE_CLAMAV=true fails closed if ClamAV is down.
CLAMD_HOST=
CLAMD_PORT=3310
SCAN_REQUIRE_CLAMAV=false
UPLOAD_MAX_BYTES=20000000
VIDEO_RETAIN_DAYS=90
NEAR_DUPE_JACCARD=0.85
INTERVIEWER_TRIAL_TURNS=8
INTERVIEWER_PAID_TURNS=500
INTERVIEWER_TRIAL_DAYS=14
INTERVIEWER_MAX_QUESTIONS=6

JOB_INGEST_ENABLED=true
JOB_INGEST_INTERVAL_SEC=30
JOB_INGEST_MAX_NEW=40
# Public career-page slugs from boards.greenhouse.io/{slug}. Not secret API keys.
JOB_INGEST_SOURCES=greenhouse:anthropic,greenhouse:databricks,greenhouse:xai,greenhouse:scaleai,greenhouse:togetherai,greenhouse:dataiku,greenhouse:stripe,greenhouse:gitlab,greenhouse:cloudflare,greenhouse:mongodb,greenhouse:elastic,greenhouse:datadog,greenhouse:figma,greenhouse:vercel,greenhouse:okta,arbeitnow
